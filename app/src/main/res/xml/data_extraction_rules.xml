<?xml version="1.0" encoding="utf-8"?>
<!-- Auth tokens must never leave the device via cloud backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="fokalpoint_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fokalpoint_session.xml" />
    </device-transfer>
</data-extraction-rules>
