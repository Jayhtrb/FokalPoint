# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# FokalPoint Supabase (set these in Vercel Project Settings > Environment Variables)
NEXT_PUBLIC_SUPABASE_URL=https://your-fokalpoint-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Legacy fallback only; prefer the publishable key above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key

# Email Notification Gateway Credentials (Stripe / SendGrid / Brevo / SMTP Simulation)
# EMAIL_SERVICE_PROVIDER: Options are "brevo", "sendgrid", "mailgun", or "mock" (default)
EMAIL_SERVICE_PROVIDER=mock
EMAIL_SERVICE_API_KEY=your_api_key_here
EMAIL_SENDER_EMAIL=bookings@fokalpoint.com
EMAIL_SENDER_NAME=FokalPoint Bookings


